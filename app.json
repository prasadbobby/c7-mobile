{
  "expo": {
    "name": "C7 Personal Fitness",
    "slug": "c7-mobile",
    "scheme": "pulsefit",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#050605",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.c7.pulsefit"
    },
    "android": {
      "package": "com.c7.pulsefit"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050605",
          "image": "./assets/images/login-illustration.png",
          "imageWidth": 160
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-sharing",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "2d3c8336-e960-4d33-bd39-a96435d4a3bd"
      }
    }
  }
}
