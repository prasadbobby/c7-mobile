{
  "name": "c7-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "check:jsx": "node scripts/check-jsx.cjs",
    "lint": "tsc --noEmit && node scripts/check-jsx.cjs",
    "build": "npm run lint && expo export -p web",
    "test:e2e": "npm run lint && EXPO_OFFLINE=1 EXPO_PUBLIC_API_URL=http://localhost:4100 EXPO_PUBLIC_AUTH_MODE=test expo export -p web --output-dir dist-e2e && playwright test",
    "test:e2e:dev": "npm run lint && E2E_DEV=1 playwright test"
  },
  "dependencies": {
    "@clerk/expo": "^4.16.1",
    "@expo-google-fonts/lexend": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.107.1",
    "expo": "~58.0.23",
    "expo-auth-session": "~58.0.18",
    "expo-blur": "~58.0.5",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.8",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.8",
    "gsap": "^3.15.1",
    "lucide-react-native": "^1.72.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.1.0",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-print": "~58.0.9",
    "expo-sensors": "~58.0.5",
    "expo-sharing": "~58.0.23",
    "expo-video": "~58.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
